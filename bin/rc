#!/usr/bin/env bash
# rc — manage always-on Claude Code sessions (tmux + supervisor loop).
#
# Desired state:  ~/.config/claude-rc/desired   ("name|dir|uuid|mode" per line)
# Kept alive by:  each session's claude-rc-loop + claude-rc-reconcile.timer.
#
# MODES — how you reach a session from the phone:
#   rc                 Remote Control (Anthropic relay). VISIBLE to anyone logged
#                      into the claude.ai account. Default for work sessions.
#   fakechat[:PORT]    local web chat on 127.0.0.1:PORT (default 8787).
#   telegram[:LABEL]   chat via your Telegram bot (one bot per session; LABEL picks
#                      a separate token dir ~/.claude/channels/telegram-LABEL).
#   Channel modes are NOT registered with the account — invisible in the app.
#
#   rc up [--private|--telegram|--fakechat[:PORT]|--rc] [--new] [name]
#   rc mode [name] [mode]   change a session mode; anything omitted is asked for
#   rc pick [name]    re-point a session to another past conversation
#   rc down [name]    stop & unregister; no name = pick from a list (Tab = multi)
#   rc ls             list sessions: live state + mode + UUID + dir
#   rc attach [name]  attach to a live session; no name = pick from a list
#   rc bots           list Telegram bot slots: which are free, which session uses which
#   rc bot add [label]  register a new bot token as a slot (telegram:<label>)
#   rc sync           capture each live session's CURRENT conversation into desired
#   rc reconcile      run the reconciler once (normally automatic)
set -euo pipefail

DESIRED="${CLAUDE_RC_DESIRED:-$HOME/.config/claude-rc/desired}"
RECONCILE="$HOME/.local/bin/claude-rc-reconcile"
DEFAULT_PRIVATE_MODE="fakechat"
mkdir -p "$(dirname "$DESIRED")"
touch "$DESIRED"

die() { echo "rc: $*" >&2; exit 1; }

valid_mode() {
  case "$1" in rc|telegram|telegram:?*|fakechat|fakechat:[0-9]*) return 0;; *) return 1;; esac
}

# A channel mode is exclusive: one bot token (telegram) or one port (fakechat)
# serves exactly one session. Refuse to hand the same slot to two sessions —
# sharing a telegram token makes the newer session SIGTERM the older one's poller.
assert_mode_free() {  # mode name-being-set
  local mode="$1" self="$2" clash
  [[ "$mode" == rc ]] && return 0
  clash="$(awk -F'|' -v m="$mode" -v s="$self" '$4==m && $1!=s {print $1; exit}' "$DESIRED")"
  [[ -z "$clash" ]] && return 0
  die "mode '$mode' is already used by '$clash' — one bot/port per session.
     telegram: create a second bot and use  telegram:<label>  (own token in ~/.claude/channels/telegram-<label>/.env)
     fakechat: pick another port, e.g.  fakechat:8801"
}

# ---- telegram bot pool ------------------------------------------------------
# One bot token serves one session (Telegram allows a single getUpdates consumer
# per token), and each token lives in its own state dir — so the dirs ARE the pool:
#   ~/.claude/channels/telegram/.env           -> mode "telegram"
#   ~/.claude/channels/telegram-<label>/.env   -> mode "telegram:<label>"
# A slot is free when no line in the desired file claims it, so `rc down` releases
# a bot automatically and the next `rc up --telegram` reuses it.
_slot_dir() {
  case "$1" in
    telegram)   printf '%s\n' "$HOME/.claude/channels/telegram" ;;
    telegram:*) printf '%s\n' "$HOME/.claude/channels/telegram-${1#telegram:}" ;;
    *) return 1 ;;
  esac
}
telegram_slots() {  # every slot that actually holds a token
  local d label
  [[ -s "$HOME/.claude/channels/telegram/.env" ]] && echo "telegram"
  for d in "$HOME"/.claude/channels/telegram-*/; do
    [[ -s "$d/.env" ]] || continue
    label="$(basename "$d")"
    echo "telegram:${label#telegram-}"
  done
  return 0
}
slot_owner() { awk -F'|' -v m="$1" '$4==m{print $1; exit}' "$DESIRED"; }
free_telegram_slot() {
  local s
  while read -r s; do
    [[ -z "$s" ]] && continue
    [[ -z "$(slot_owner "$s")" ]] && { printf '%s\n' "$s"; return 0; }
  done < <(telegram_slots)
  return 1
}
_bot_token() { grep -m1 '^TELEGRAM_BOT_TOKEN=' "$(_slot_dir "$1")/.env" 2>/dev/null | cut -d= -f2- | tr -d '[:space:]'; }
_bot_rename() {  # mode session-name — best effort, keeps the bot named after its session
  local t; t="$(_bot_token "$1")" || return 0
  [[ -z "$t" ]] && return 0
  command -v curl >/dev/null 2>&1 || return 0
  curl -s --max-time 10 -X POST "https://api.telegram.org/bot${t}/setMyName" \
       --data-urlencode "name=$2" >/dev/null 2>&1 || true
}
# Bare "telegram" means "any free bot" — resolve it to a concrete slot.
resolve_telegram() {  # requested-mode name-being-set -> concrete mode
  local want="$1" self="$2" cur free
  [[ "$want" != telegram ]] && { printf '%s\n' "$want"; return 0; }
  cur="$(slot_owner telegram)"
  [[ -z "$cur" || "$cur" == "$self" ]] && { echo telegram; return 0; }
  free="$(free_telegram_slot)" || die "all Telegram bots are taken:
$(cmd_bots_lines)
     Add one:  BotFather /newbot  ->  rc bot add <label>"
  printf '%s\n' "$free"
}

# ---- desired-state helpers --------------------------------------------------
get_field() {  # name fieldno -> value
  awk -F'|' -v n="$1" -v f="$2" '$1==n{print $f; exit}' "$DESIRED"
}
register() {  # name dir uuid mode — upsert keyed by EXACT name
  local name="$1" dir="$2" uuid="$3" mode="${4:-rc}" tmp
  tmp="$(mktemp)"
  awk -F'|' -v n="$name" -v d="$dir" -v u="$uuid" -v m="$mode" \
    '$1==n{next}{print}END{print n"|"d"|"u"|"m}' "$DESIRED" > "$tmp"
  mv "$tmp" "$DESIRED"
}
unregister() {
  local name="$1" tmp
  tmp="$(mktemp)"
  awk -F'|' -v n="$name" '$1!=n' "$DESIRED" > "$tmp"
  mv "$tmp" "$DESIRED"
}

# ---- conversation discovery / interactive picker ----------------------------
slug_of() { printf '%s' "$1" | sed 's/[^a-zA-Z0-9]/-/g'; }

_convo_preview() {  # jsonl-file -> short one-line preview (best effort)
  command -v python3 >/dev/null 2>&1 || return 0
  python3 - "$1" <<'PY' 2>/dev/null || true
import json, sys
txt = ""
try:
    with open(sys.argv[1]) as fh:
        for line in fh:
            try: d = json.loads(line)
            except Exception: continue
            if d.get("type") == "summary" and d.get("summary"):
                txt = d["summary"]; break
            m = d.get("message")
            if isinstance(m, dict) and m.get("role") == "user":
                c = m.get("content")
                if isinstance(c, str): txt = c
                elif isinstance(c, list):
                    for it in c:
                        if isinstance(it, dict) and it.get("type") == "text":
                            txt = it.get("text", ""); break
                t = txt.strip()
                if t and not t.startswith("<"):  # skip /command + caveat wrappers
                    txt = t; break
                txt = ""
except Exception:
    pass
print(" ".join(txt.split())[:70])
PY
}

_convo_rows() {  # "uuid<TAB>display" for past conversations in DIR, newest first
  local dir="$1" proj f uuid when prev
  proj="$HOME/.claude/projects/$(slug_of "$dir")"
  [[ -d "$proj" ]] || return 0
  for f in $(ls -1t "$proj"/*.jsonl 2>/dev/null | head -50); do
    uuid="$(basename "$f" .jsonl)"
    when="$(date -r "$f" '+%Y-%m-%d %H:%M' 2>/dev/null || echo '?')"
    prev="$(_convo_preview "$f")"
    printf '%s\t%s  %s  %s\n' "$uuid" "${uuid:0:8}" "$when" "${prev:-(no preview)}"
  done
}

pick_convo() {  # echoes chosen UUID, empty = new conversation, rc 1 = cancelled
  local dir="$1" rows
  rows="$(_convo_rows "$dir")"
  [[ -z "$rows" ]] && return 0
  if command -v fzf >/dev/null 2>&1; then
    local sel id
    sel="$( { printf '__new__\t✨ start a NEW conversation\n'; printf '%s\n' "$rows"; } \
            | fzf --with-nth=2.. --delimiter='\t' --height=45% --reverse --no-sort \
                  --prompt="pick conversation in $(basename "$dir") > " )" || return 1
    id="${sel%%$'\t'*}"
    [[ "$id" == "__new__" || -z "$id" ]] && return 0
    printf '%s\n' "$id"
  else
    local -a ids=("__new__") disp=("✨ start a NEW conversation") id d i choice
    while IFS=$'\t' read -r id d; do ids+=("$id"); disp+=("$d"); done <<< "$rows"
    for i in "${!disp[@]}"; do printf '  %2d) %s\n' "$i" "${disp[$i]}" >&2; done
    read -rp "Choose [0-$((${#ids[@]}-1))], or blank to cancel: " choice </dev/tty || return 1
    [[ -z "$choice" ]] && return 1
    [[ "$choice" =~ ^[0-9]+$ ]] || die "invalid choice"
    id="${ids[$choice]:-}"
    [[ "$id" == "__new__" || -z "$id" ]] && return 0
    printf '%s\n' "$id"
  fi
}

pick_mode() {  # echoes chosen mode, rc 1 on cancel
  local rows sel m port
  rows="Remote Control — reachable from the Claude app; VISIBLE to anyone logged into the account"$'\t'"rc"$'\n'
  rows+="Telegram — chat via your bot; not registered with the account"$'\t'"telegram"$'\n'
  rows+="fakechat — local web chat on 127.0.0.1; not registered with the account"$'\t'"fakechat"$'\n'
  if command -v fzf >/dev/null 2>&1; then
    sel="$(printf '%s' "$rows" | fzf --with-nth=1 --delimiter='\t' --height=30% --reverse --no-sort --prompt='mode > ')" || return 1
    m="${sel#*$'\t'}"
  else
    local -a vals=() disp=(); local d v i choice
    while IFS=$'\t' read -r d v; do disp+=("$d"); vals+=("$v"); done < <(printf '%s' "$rows")
    for i in "${!disp[@]}"; do printf '  %2d) %s\n' "$i" "${disp[$i]}" >&2; done
    read -rp "Mode [0-$((${#vals[@]}-1))]: " choice </dev/tty || return 1
    [[ "$choice" =~ ^[0-9]+$ ]] || return 1
    m="${vals[$choice]:-}"
  fi
  [[ -z "$m" ]] && return 1
  if [[ "$m" == fakechat ]]; then
    # one port per session — ask, because a second fakechat on 8787 will not start
    read -rp "fakechat port [8787]: " port </dev/tty || true
    [[ -n "${port:-}" ]] && m="fakechat:$port"
  fi
  printf '%s\n' "$m"
}

pick_session_from_desired() {  # echoes "name|dir", rc 1 on cancel/none
  local -a keys=() disp=()
  local name dir uuid mode i
  while IFS='|' read -r name dir uuid mode; do
    [[ -z "$name" || "$name" == \#* ]] && continue
    keys+=("$name|$dir")
    disp+=("$(printf '%-22s %-14s %-10s %s' "$name" "${mode:-rc}" "${uuid:0:8}" "$dir")")
  done < "$DESIRED"
  [[ ${#keys[@]} -eq 0 ]] && { echo "rc: no registered sessions (rc up first)" >&2; return 1; }
  [[ ${#keys[@]} -eq 1 ]] && { printf '%s\n' "${keys[0]}"; return 0; }
  if command -v fzf >/dev/null 2>&1; then
    local tsv="" sel
    for i in "${!keys[@]}"; do tsv+="${disp[$i]}"$'\t'"${keys[$i]}"$'\n'; done
    sel="$(printf '%s' "$tsv" | fzf --with-nth=1 --delimiter='\t' --height=45% --reverse --prompt='pick session > ')" || return 1
    [[ -z "$sel" ]] && return 1
    printf '%s\n' "${sel#*$'\t'}"
  else
    local choice
    for i in "${!disp[@]}"; do printf '  %2d) %s\n' "$i" "${disp[$i]}" >&2; done
    read -rp "Session [0-$((${#keys[@]}-1))]: " choice </dev/tty || return 1
    [[ "$choice" =~ ^[0-9]+$ ]] || return 1
    printf '%s\n' "${keys[$choice]:-}"
  fi
}

# ---- start / restart --------------------------------------------------------
_start_now() {
  local name="$1"
  if tmux -L claude-rc has-session -t "=$name" 2>/dev/null; then
    echo "rc: '$name' already live"
    return 0
  fi
  "$RECONCILE" >/dev/null 2>&1 || true
  sleep 1
  if tmux -L claude-rc has-session -t "=$name" 2>/dev/null; then
    echo "rc: '$name' is live [$(get_field "$name" 4)]"
  else
    echo "rc: '$name' registered but tmux did not start — check: rc reconcile"
  fi
}

_restart() {  # stop the tmux session so reconcile respawns it with current settings
  local name="$1"
  tmux -L claude-rc kill-session -t "=$name" 2>/dev/null || true
  sleep 1
  _start_now "$name"
}

cmd_up() {
  local force_new=0 mode="" dir name uuid
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --new|-n)      force_new=1; shift ;;
      --private)     mode="$DEFAULT_PRIVATE_MODE"; shift ;;
      --telegram)    mode="telegram"; shift ;;
      --fakechat)    mode="fakechat"; shift ;;
      --fakechat:*)  mode="${1#--}"; shift ;;
      --rc)          mode="rc"; shift ;;
      --) shift; break ;;
      -*) die "unknown flag '$1'" ;;
      *) break ;;
    esac
  done
  dir="$(pwd -P)"
  name="${1:-$(basename "$dir")}"
  case "$name" in *'|'*) die "name cannot contain '|'";; esac
  [[ -n "$mode" ]] && { valid_mode "$mode" || die "bad mode '$mode'"; }
  [[ -z "$mode" ]] && mode="$(get_field "$name" 4)"   # existing session keeps its mode
  if [[ -z "$mode" ]]; then                           # new session: ask, don't assume
    if [[ -t 0 && -t 1 ]]; then
      mode="$(pick_mode)" || { echo "rc up: cancelled"; return 1; }
    else
      mode="rc"
    fi
  fi

  uuid="$(get_field "$name" 3)"
  if [[ -z "$uuid" ]]; then
    if [[ $force_new -eq 0 && -t 0 && -t 1 ]]; then
      uuid="$(pick_convo "$dir")" || { echo "rc up: cancelled"; return 1; }
    fi
    [[ -z "$uuid" ]] && uuid="$(uuidgen)"
  fi
  mode="$(resolve_telegram "$mode" "$name")"
  assert_mode_free "$mode" "$name"
  register "$name" "$dir" "$uuid" "$mode"
  [[ "$mode" == telegram* ]] && _bot_rename "$mode" "$name"
  echo "rc up: '$name' [$mode] -> $dir (uuid=${uuid:0:8})"
  _start_now "$name"
}

cmd_mode() {
  # Args may come in either order and either may be omitted — whatever is missing
  # is asked for interactively: `rc mode`, `rc mode telegram`, `rc mode "Name"`.
  local name="" new="" a sel dir
  for a in "$@"; do
    if valid_mode "$a"; then new="$a"; else name="$a"; fi
  done
  if [[ -z "$name" ]]; then
    sel="$(pick_session_from_desired)" || { echo "rc mode: cancelled"; return 1; }
    name="${sel%%|*}"
  fi
  dir="$(get_field "$name" 2)"
  [[ -z "$dir" ]] && die "no such session '$name'"
  if [[ -z "$new" ]]; then
    echo "current: ${name} [$(get_field "$name" 4 | grep . || echo rc)]" >&2
    new="$(pick_mode)" || { echo "rc mode: cancelled"; return 1; }
  fi
  valid_mode "$new" || die "bad mode '$new' (rc | telegram[:LABEL] | fakechat[:PORT])"
  new="$(resolve_telegram "$new" "$name")"
  assert_mode_free "$new" "$name"
  register "$name" "$dir" "$(get_field "$name" 3)" "$new"
  [[ "$new" == telegram* ]] && _bot_rename "$new" "$name"
  echo "rc mode: '$name' -> $new (restarting)"
  _restart "$name"
}

cmd_pick() {
  local name dir uuid sel
  if [[ -n "${1:-}" ]]; then
    name="$1"
    case "$name" in *'|'*) die "name cannot contain '|'";; esac
    dir="$(get_field "$name" 2)"
    [[ -z "$dir" ]] && dir="$(pwd -P)"
  else
    sel="$(pick_session_from_desired)" || { echo "rc pick: cancelled"; return 1; }
    [[ -z "$sel" ]] && return 1
    name="${sel%%|*}"; dir="${sel#*|}"
  fi
  [[ -n "$(_convo_rows "$dir")" ]] || die "no past conversations in $dir (use: rc up --new \"$name\")"
  uuid="$(pick_convo "$dir")" || { echo "rc pick: cancelled"; return 1; }
  [[ -z "$uuid" ]] && uuid="$(uuidgen)"
  register "$name" "$dir" "$uuid" "$(get_field "$name" 4)"
  echo "rc pick: '$name' -> uuid=${uuid:0:8}"
  _start_now "$name"
}

_down_one() {
  local name="$1"
  unregister "$name"
  if tmux -L claude-rc has-session -t "=$name" 2>/dev/null; then
    tmux -L claude-rc kill-session -t "=$name"
    echo "rc down: '$name' stopped & unregistered"
  else
    echo "rc down: '$name' unregistered (was not live)"
  fi
}

cmd_down() {
  if [[ -n "${1:-}" ]]; then _down_one "$1"; return; fi
  local rows="" name dir uuid mode
  while IFS='|' read -r name dir uuid mode; do
    [[ -z "$name" || "$name" == \#* ]] && continue
    rows+="$(printf '%-24s %-14s %-10s %s' "$name" "${mode:-rc}" "${uuid:0:8}" "$dir")"$'\t'"$name"$'\n'
  done < "$DESIRED"
  [[ -z "$rows" ]] && die "no registered sessions"
  local -a chosen=()
  if command -v fzf >/dev/null 2>&1; then
    local sel line
    sel="$(printf '%s' "$rows" | fzf --multi --with-nth=1 --delimiter='\t' --height=50% --reverse \
            --prompt='down (Tab=mark many, Enter=confirm) > ')" || { echo "rc down: cancelled"; return 1; }
    [[ -z "$sel" ]] && { echo "rc down: nothing selected"; return 0; }
    while IFS= read -r line; do chosen+=("${line#*$'\t'}"); done <<< "$sel"
  else
    local -a keys=() disp=(); local d k i input tok
    while IFS=$'\t' read -r d k; do disp+=("$d"); keys+=("$k"); done < <(printf '%s' "$rows")
    for i in "${!disp[@]}"; do printf '  %2d) %s\n' "$i" "${disp[$i]}" >&2; done
    read -rp "Down which? (numbers, space/comma separated): " input </dev/tty || return 1
    for tok in ${input//,/ }; do [[ "$tok" =~ ^[0-9]+$ ]] && chosen+=("${keys[$tok]}"); done
  fi
  [[ ${#chosen[@]} -eq 0 ]] && { echo "rc down: nothing selected"; return 0; }
  for name in "${chosen[@]}"; do _down_one "$name"; done
}

cmd_ls() {
  printf '%-24s %-5s %-14s %-10s %s\n' NAME LIVE MODE UUID DIR
  local name dir uuid mode live
  while IFS='|' read -r name dir uuid mode; do
    [[ -z "$name" || "$name" == \#* ]] && continue
    if tmux -L claude-rc has-session -t "=$name" 2>/dev/null; then live=yes; else live=no; fi
    printf '%-24s %-5s %-14s %-10s %s\n' "$name" "$live" "${mode:-rc}" "${uuid:0:8}" "$dir"
  done < "$DESIRED"
}

cmd_attach() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    local live; live="$(tmux -L claude-rc list-sessions -F '#S' 2>/dev/null)"
    [[ -z "$live" ]] && die "no live sessions (rc up to start one)"
    if [[ "$(printf '%s\n' "$live" | grep -c .)" -eq 1 ]]; then
      name="$live"
    elif command -v fzf >/dev/null 2>&1; then
      name="$(printf '%s\n' "$live" | sort | fzf --height=40% --reverse --prompt='attach to > ')" \
        || { echo "rc attach: cancelled"; return 1; }
    else
      local -a arr; mapfile -t arr < <(printf '%s\n' "$live" | sort)
      local i choice
      for i in "${!arr[@]}"; do printf '  %2d) %s\n' "$i" "${arr[$i]}" >&2; done
      read -rp "Attach to [0-$((${#arr[@]}-1))]: " choice </dev/tty || return 1
      [[ "$choice" =~ ^[0-9]+$ ]] || return 1
      name="${arr[$choice]:-}"
    fi
    [[ -z "$name" ]] && return 1
  fi
  tmux -L claude-rc has-session -t "=$name" 2>/dev/null || die "no live session '$name' (rc ls to see them)"
  exec tmux -L claude-rc attach -t "=$name"
}

cmd_bots_lines() {
  local s owner tok name
  while read -r s; do
    [[ -z "$s" ]] && continue
    owner="$(slot_owner "$s")"
    tok="$(_bot_token "$s")"
    name="?"
    if [[ -n "$tok" ]] && command -v curl >/dev/null 2>&1; then
      name="$(curl -s --max-time 8 "https://api.telegram.org/bot${tok}/getMe" 2>/dev/null \
              | sed -n 's/.*"username":"\([^"]*\)".*/@\1/p' | head -1)"
      [[ -z "$name" ]] && name="(unreachable)"
    fi
    printf '     %-22s %-30s %s\n' "$s" "$name" "${owner:-FREE}"
  done < <(telegram_slots)
}

cmd_bots() {
  printf '%-22s %-30s %s\n' SLOT BOT 'USED BY'
  cmd_bots_lines | sed 's/^     //'
}

cmd_bot() {
  local sub="${1:-}" label="${2:-}" dir tok
  case "$sub" in
    add)
      [[ -z "$label" ]] && { read -rp "label for the new bot (e.g. banking): " label </dev/tty; }
      [[ "$label" =~ ^[a-z0-9-]+$ ]] || die "label must be lowercase letters/digits/dashes"
      dir="$HOME/.claude/channels/telegram-$label"
      [[ -s "$dir/.env" ]] && die "slot telegram:$label already has a token"
      mkdir -p "$dir"; chmod 700 "$dir"
      echo "Create the bot first: Telegram -> @BotFather -> /newbot" >&2
      read -rsp "Paste its token: " tok </dev/tty; echo >&2
      [[ "$tok" =~ ^[0-9]{6,}:[A-Za-z0-9_-]{30,}$ ]] || die "that does not look like a bot token"
      printf 'TELEGRAM_BOT_TOKEN=%s\n' "$tok" > "$dir/.env"; chmod 600 "$dir/.env"
      if command -v curl >/dev/null 2>&1; then
        curl -s --max-time 10 "https://api.telegram.org/bot${tok}/getMe" \
          | grep -q '"ok":true' && echo "✔ token works — slot ready: telegram:$label" \
          || { rm -f "$dir/.env"; die "Telegram rejected that token"; }
      else
        echo "slot ready: telegram:$label (could not verify, no curl)"
      fi
      ;;
    ls|"") cmd_bots ;;
    *) die "usage: rc bot add [label] | rc bots" ;;
  esac
}

usage() { sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'; }

case "${1:-}" in
  up)             shift; cmd_up "$@";;
  mode)           shift; cmd_mode "$@";;
  pick)           shift; cmd_pick "$@";;
  down)           shift; cmd_down "$@";;
  ls|list)        cmd_ls;;
  attach|a)       shift; cmd_attach "$@";;
  bots)           cmd_bots;;
  bot)            shift; cmd_bot "$@";;
  sync|reconcile) exec "$RECONCILE";;
  ""|-h|--help|help) usage;;
  *) die "unknown command '$1' (try: rc --help)";;
esac
